{
  "name": "arfd-market-rule-mysql",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "host.docker.internal",
    "database.port": "3306",
    "database.user": "arfd",
    "database.password": "arfd",
    "database.server.id": "5400",
    "topic.prefix": "arfd",
    "database.include.list": "market_db",
    "table.include.list": "market_db.market_rule",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "arfd.schemahistory.market_rule",
    "include.schema.changes": "false",
    "snapshot.mode": "initial",
    "tombstones.on.delete": "true",
    "snapshot.locking.mode": "none"
  }
}
